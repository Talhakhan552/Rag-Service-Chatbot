# Production environment. Copy to .env.production and fill in real
# values -- NEVER commit this file (it's already covered by
# .gitignore/.dockerignore patterns for .env*).

# ==============================
# App
# ==============================
APP_NAME=RAG Chatbot SaaS
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ==============================
# Security
# ==============================
# Generate a NEW value for production -- never reuse the dev one.
# openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# Database
# ==============================
POSTGRES_USER=raguser
POSTGRES_PASSWORD=
POSTGRES_DB=ragchatbot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://raguser:CHANGE_ME@db:5432/ragchatbot

# ==============================
# Redis
# ==============================
REDIS_URL=redis://redis:6379/0

# ==============================
# LLM Providers
# ==============================
DEFAULT_LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ==============================
# File storage
# ==============================
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_PER_MINUTE=60

# ==============================
# CORS -- your real production domain, NOT localhost
# ==============================
CORS_ORIGINS=https://your-domain.com

# ==============================
# Frontend build (used by docker-compose.prod.yml, not the app itself)
# ==============================
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1