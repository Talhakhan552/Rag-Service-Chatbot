# ==============================
# App
# ==============================
APP_NAME=RAG Chatbot SaaS
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ==============================
# Security
# ==============================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# Database (Postgres + pgvector)
# ==============================
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ragchatbot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://raguser:change_me@db:5432/ragchatbot

# ==============================
# Redis (cache, rate limiting, background task coordination)
# ==============================
REDIS_URL=redis://redis:6379/0

# ==============================
# LLM Providers
# ==============================
DEFAULT_LLM_PROVIDER=openai   # openai | anthropic | gemini

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ==============================
# File storage
# ==============================
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_PER_MINUTE=60

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:3000
